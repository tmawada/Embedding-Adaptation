# ---------------------------------------------------------------------------
# Datasets and embedding caches: large, regenerable with prepare.py
# ---------------------------------------------------------------------------
/data/
**/cache/

# ---------------------------------------------------------------------------
# Trained weights and binary artefacts
# ---------------------------------------------------------------------------
*.npy
*.pt
*.safetensors
*.bin
*.onnx
*.model

# ---------------------------------------------------------------------------
# Logs, API-call caches, TensorBoard events
# ---------------------------------------------------------------------------
*.log
*.jsonl
events.out.tfevents.*
/logs/

# ---------------------------------------------------------------------------
# Training output directories (methods/<name>/outputs/; llm_rewrite and
# multi_seed still use runs/): ignore checkpoints, keep the small result summaries
# ---------------------------------------------------------------------------
**/runs/**
!**/runs/**/
!**/runs/**/*.md
!**/runs/**/summary*.json
!**/runs/**/report*.json
!**/runs/**/comparison*.json
!**/runs/**/test_*.json
!**/runs/**/zero_shot*.json

**/outputs/**
!**/outputs/**/
!**/outputs/**/*.md
!**/outputs/**/summary*.json
!**/outputs/**/report*.json
!**/outputs/**/comparison*.json
!**/outputs/**/test_*.json
!**/outputs/**/zero_shot*.json
!**/outputs/**/*_results.json

# ---------------------------------------------------------------------------
# Python / editor / secrets
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.gemini_api_key
*.tmp
